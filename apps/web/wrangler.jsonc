{
  "name": "cf-tanstack-starter",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./app/server-entry.ts",

  // Cloudflare Workers native observability
  // Auto-instruments: fetch, D1, R2, KV, handler lifecycle
  // Console output captured as OTel logs
  // Configure OTLP export destinations in the CF dashboard
  "observability": {
    "enabled": true,
    // 100% sampling is right for a starter; lower this at scale to control cost
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": true
    }
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-tanstack-starter-db",
      "database_id": "ac9e5526-234c-43e5-90cc-849ee09a8d3a"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "73e4739104254e7f9637cbece9584e44"
    },
    {
      "binding": "FLAGS",
      "id": "d73dbf2dd92f4162ba34ebefbecf377d"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "cf-tanstack-starter-bucket"
    }
  ],

  "triggers": {
    "crons": ["0 * * * *", "*/15 * * * *"]
  },

  "vars": {
    "BETTER_AUTH_URL": "https://cf-tanstack-starter.mjpowersjr.workers.dev",
    "SIGNUP_ENABLED": "true",
    // Accounts created with these emails are auto-promoted to admin.
    // Set this BEFORE first deploy — there is no other bootstrap path in prod
    // (the old "first registrant becomes admin" behavior was removed as unsafe).
    "ADMIN_EMAILS": "mjpowersjr@gmail.com"
  },

  // Staging environment — deployed from `staging` branch.
  //
  // The *_STAGING_ID values are placeholders: pushing to `staging` will fail
  // until you create the resources and paste the real IDs here:
  //   wrangler d1 create cf-tanstack-starter-db-staging
  //   wrangler kv namespace create RATE_LIMIT --env staging
  //   wrangler kv namespace create FLAGS --env staging
  //   wrangler r2 bucket create cf-tanstack-starter-bucket-staging
  //   wrangler secret put BETTER_AUTH_SECRET --env staging
  //
  // Wrangler env inheritance is per-key: top-level `observability` and
  // `triggers` do NOT apply to named envs, so they are re-declared here.
  "env": {
    "staging": {
      "name": "cf-tanstack-starter-staging",
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "invocation_logs": true
        }
      },
      "triggers": {
        "crons": ["0 * * * *", "*/15 * * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cf-tanstack-starter-db-staging",
          "database_id": "STAGING_D1_ID"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "RATE_LIMIT",
          "id": "RATE_LIMIT_KV_STAGING_ID"
        },
        {
          "binding": "FLAGS",
          "id": "FLAGS_KV_STAGING_ID"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "cf-tanstack-starter-bucket-staging"
        }
      ],
      "vars": {
        // workers.dev URLs include your account subdomain — check `wrangler whoami`
        "BETTER_AUTH_URL": "https://cf-tanstack-starter-staging.mjpowersjr.workers.dev",
        "SIGNUP_ENABLED": "true",
        "ADMIN_EMAILS": "mjpowersjr@gmail.com"
      }
    }
  }
}

{
  "name": "@repo/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "routes:generate": "tsx scripts/generate-routes.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "db:migrate:local": "pnpm --filter @repo/db db:migrate:local",
    "db:migrate:remote": "pnpm --filter @repo/db db:migrate:remote",
    "db:seed": "wrangler d1 execute DB --local --file ../../packages/db/seed.sql",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:staging": "pnpm build && wrangler deploy --env staging",
    "preview": "wrangler dev --remote",
    "tail": "wrangler tail",
    "db:snapshot": "pnpm --filter @repo/db db:snapshot",
    "shadcn:diff": "tsx scripts/shadcn.ts diff",
    "shadcn:update": "tsx scripts/shadcn.ts update",
    "cf:secret:list": "wrangler secret list",
    "cf:secret:put": "wrangler secret put"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.0",
    "@repo/db": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/observability": "workspace:*",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.28",
    "better-auth": "^1.6.23",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "npm:drizzle-orm@beta",
    "lucide-react": "1.24.0",
    "radix-ui": "^1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "3.6.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.45.0",
    "@cloudflare/workers-types": "5.20260717.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-generator": "1.167.19",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "^4.1.10",
    "wrangler": "4.111.0"
  }
}
